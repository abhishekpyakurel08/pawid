{
  "openapi": "3.0.3",
  "info": {
    "title": "PawID REST API",
    "description": "PawID Animal Identity & Community-Care Platform API Documentation",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Development Server"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user account (Volunteer / Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "John Doe" },
                  "email": { "type": "string", "example": "volunteer@example.test" },
                  "password": { "type": "string", "example": "Password123!" },
                  "role": { "type": "string", "enum": ["ADMIN", "VOLUNTEER"], "default": "VOLUNTEER" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "admin@example.test" },
                  "password": { "type": "string", "example": "Password123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns JWT access and refresh tokens" }
        }
      }
    },
    "/public/dogs/{qrToken}": {
      "get": {
        "summary": "Get safe public dog profile by QR token",
        "parameters": [
          {
            "name": "qrToken",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Public dog profile returned without sensitive registration info" }
        }
      }
    },
    "/public/dogs/{qrToken}/sightings": {
      "post": {
        "summary": "Submit voluntary sighting for public dog profile",
        "parameters": [
          {
            "name": "qrToken",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["location", "locationSource", "voluntarilySharedLocation"],
                "properties": {
                  "location": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "example": "Point" },
                      "coordinates": { "type": "array", "items": { "type": "number" }, "example": [85.3240, 27.7172] }
                    }
                  },
                  "locationSource": { "type": "string", "enum": ["CURRENT_LOCATION", "MAP_SELECTION", "MANUAL_ENTRY"] },
                  "voluntarilySharedLocation": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Sighting recorded" }
        }
      }
    },
    "/dogs": {
      "post": {
        "summary": "Register a new dog and generate PawID + QR token",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Dog created with QR code Data URL" }
        }
      },
      "get": {
        "summary": "Get paginated dogs with filters",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of dogs" }
        }
      }
    },
    "/admin/dashboard": {
      "get": {
        "summary": "Get admin dashboard analytics and recent activity",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dashboard metrics" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
